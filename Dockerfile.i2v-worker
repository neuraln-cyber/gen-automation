# syntax=docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be

LABEL org.opencontainers.image.title="gen-automation-dasiwa-i2v-worker" \
      org.opencontainers.image.description="Model-free DaSiWa WAN 2.2 image-to-video worker" \
      org.opencontainers.image.source="https://github.com/neuraln-cyber/gen-automation" \
      org.opencontainers.image.comfyui.revision="c2bcbecd82ec5ae66594340b395c24ef0217b238" \
      org.opencontainers.image.runpod-sdk.version="1.11.0"

ENV DEBIAN_FRONTEND=noninteractive \
    COMFYUI_COMMIT=c2bcbecd82ec5ae66594340b395c24ef0217b238 \
    VIRTUAL_ENV=/opt/i2v-venv \
    PATH=/opt/i2v-venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/i2v/src:/opt/i2v/vendor \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/i2v-worker

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ADD --checksum=sha256:012096056b97abf1f68c46b7146bd2cbd68c1be762340b4f5dad4fbbe99177bc \
    --chmod=0444 \
    https://conda.anaconda.org/conda-forge/linux-64/openssl-3.6.3-h35e630c_1.conda \
    /tmp/openssl-3.6.3-h35e630c_1.conda

RUN /opt/conda/bin/conda install \
        --yes \
        --offline \
        --no-deps \
        /tmp/openssl-3.6.3-h35e630c_1.conda \
    && test "$(/opt/conda/bin/openssl version | awk '{print $2}')" = "3.6.3" \
    && /opt/conda/bin/conda clean --all --yes \
    && rm -f /tmp/openssl-3.6.3-h35e630c_1.conda

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && mkdir --parents /opt/comfyui \
    && git -C /opt/comfyui init \
    && git -C /opt/comfyui remote add origin https://github.com/Comfy-Org/ComfyUI.git \
    && git -C /opt/comfyui fetch --depth 1 origin "${COMFYUI_COMMIT}" \
    && git -C /opt/comfyui checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/comfyui rev-parse HEAD)" = "${COMFYUI_COMMIT}" \
    && rm -rf /opt/comfyui/.git \
    && apt-get purge --yes --auto-remove git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/i2v

COPY requirements-i2v-worker.lock ./requirements-i2v-worker.lock

RUN /opt/conda/bin/python -c "import sys; assert sys.version_info[:2] == (3, 11)" \
    && /opt/conda/bin/python -m venv \
        --copies \
        --without-pip \
        --system-site-packages \
        /opt/i2v-venv \
    && /opt/i2v-venv/bin/python -m pip install \
        --only-binary=:all: \
        --require-hashes \
        --no-deps \
        -r requirements-i2v-worker.lock \
    && /opt/i2v-venv/bin/python -c "import torch, torchaudio, torchvision; assert torch.__version__.split('+')[0] == '2.9.1'; assert torchvision.__version__.split('+')[0] == '0.24.1'; assert torchaudio.__version__.split('+')[0] == '2.9.1'; assert all('/opt/i2v-venv/' not in module.__file__ for module in (torch, torchaudio, torchvision))" \
    && grep -Fq 'class UNETLoader:' /opt/comfyui/nodes.py \
    && grep -Fq 'class LoraLoaderModelOnly' /opt/comfyui/nodes.py \
    && grep -Fq 'class KSamplerAdvanced:' /opt/comfyui/nodes.py \
    && grep -Fq 'class ModelSamplingSD3' /opt/comfyui/comfy_extras/nodes_model_advanced.py \
    && grep -Fq 'class WanImageToVideo' /opt/comfyui/comfy_extras/nodes_wan.py

# Keep the pinned face-control extension after the heavyweight, unchanged v4
# runtime layers. Publication can then reuse those proven blobs, and RunPod
# only needs to pull this small extension layer plus the application delta.
ARG COMFYUI_NAG_COMMIT=ef8a641be08983cf5f06669f70719b6eecce3c7f
ARG COMFYUI_NAG_PATCH_SHA256=63d93ed85b7ae819328a27b928f39944690988d964cc336da8a82b63c06917e8

COPY patches/comfyui-nag/chroma-stream-blocks.patch /tmp/chroma-stream-blocks.patch

RUN printf '%s  %s\n' \
        "${COMFYUI_NAG_PATCH_SHA256}" \
        /tmp/chroma-stream-blocks.patch \
        | sha256sum -c - \
    && apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && mkdir --parents /opt/comfyui/custom_nodes/ComfyUI-NAG \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-NAG init \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-NAG remote add origin \
        https://github.com/ChenDarYen/ComfyUI-NAG.git \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-NAG fetch --depth 1 origin \
        "${COMFYUI_NAG_COMMIT}" \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-NAG checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/comfyui/custom_nodes/ComfyUI-NAG rev-parse HEAD)" = \
        "${COMFYUI_NAG_COMMIT}" \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-NAG apply \
        --check /tmp/chroma-stream-blocks.patch \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-NAG apply \
        /tmp/chroma-stream-blocks.patch \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-NAG diff --check \
    && grep -Fq 'from comfy.ldm.flux.layers import' \
        /opt/comfyui/custom_nodes/ComfyUI-NAG/chroma/layers.py \
    && grep -Fq 'from comfy.ldm.flux.layers import' \
        /opt/comfyui/custom_nodes/ComfyUI-NAG/chroma/model.py \
    && grep -Fq '"KSamplerWithNAG (Advanced)"' \
        /opt/comfyui/custom_nodes/ComfyUI-NAG/node.py \
    && /opt/i2v-venv/bin/python -c \
        "import importlib.util,sys; sys.argv=['comfyui-build-check','--cpu']; p='/opt/comfyui/custom_nodes/ComfyUI-NAG'; sys.path.insert(0,'/opt/comfyui'); import comfy.options; comfy.options.enable_args_parsing(); s=importlib.util.spec_from_file_location('comfyui_nag',f'{p}/__init__.py',submodule_search_locations=[p]); assert s is not None and s.loader is not None; m=importlib.util.module_from_spec(s); sys.modules['comfyui_nag']=m; s.loader.exec_module(m); assert 'KSamplerWithNAG (Advanced)' in m.NODE_CLASS_MAPPINGS" \
    && rm -rf /opt/comfyui/custom_nodes/ComfyUI-NAG/.git \
    && apt-get purge --yes --auto-remove git \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.comfyui-nag.revision="${COMFYUI_NAG_COMMIT}"
ENV COMFYUI_NAG_COMMIT="${COMFYUI_NAG_COMMIT}"

# Source-face stabilization is an immutable, CPU-only post-process. Keep it
# after the existing runtime/NAG layers so a face-control revision does not
# invalidate the multi-gigabyte CUDA and ComfyUI blobs.
ARG ANIME_FACE_DETECTOR_REVISION=7db835de7a3a052eb4d68d241ae9f2cf28a0b509
ARG ANIME_FACE_DETECTOR_WHEEL_SHA256=9a6a8c1384b7a57fab8ce9988f814271ff88bac52a9dd871490a28b61dff7692
ARG ANIME_FACE_YOLO_SHA256=23bbc708146bcbc1c910f00fe152adbc70d7658d875a0121eaf4ee61d978b2c4
ARG ANIME_FACE_HRNET_SHA256=e71271376406a743c01528a0460637fcc06e72aeeea583f85007cc72dc8b7a4a
ARG OPENCV_HEADLESS_SHA256=211e581f5a4670acbbe08fff36a35e9946039d2eea28b80394632d036d1be527

ADD --checksum=sha256:9a6a8c1384b7a57fab8ce9988f814271ff88bac52a9dd871490a28b61dff7692 \
    --chmod=0444 \
    https://files.pythonhosted.org/packages/ff/42/a164a2431cff2acc0cace7448d7c61702ecab49a8ed44c7fdd3b704de3f3/anime_face_detector-0.1.0-py3-none-any.whl \
    /tmp/anime-face-detector.whl
ADD --checksum=sha256:23bbc708146bcbc1c910f00fe152adbc70d7658d875a0121eaf4ee61d978b2c4 \
    --chmod=0444 \
    https://huggingface.co/hysts/anime-face-detector-yolov3/resolve/afdd4226a79ae8bb81f334dbcffd34f8cc000c38/model.safetensors \
    /opt/i2v/face-models/yolov3.safetensors
ADD --checksum=sha256:e71271376406a743c01528a0460637fcc06e72aeeea583f85007cc72dc8b7a4a \
    --chmod=0444 \
    https://huggingface.co/hysts/anime-face-detector-hrnetv2/resolve/9b3435248b26aeb82e2a8578fe9d86d5d57158af/model.safetensors \
    /opt/i2v/face-models/hrnetv2.safetensors
ADD --checksum=sha256:d041f98f4392370b9df7078023b9ebdaa18da812accbb866e1bcda962108fe0f \
    --chmod=0444 \
    https://raw.githubusercontent.com/hysts/anime-face-detector/7db835de7a3a052eb4d68d241ae9f2cf28a0b509/assets/input.jpg \
    /tmp/anime-face-detector-input.jpg

COPY requirements-i2v-face.lock ./requirements-i2v-face.lock
COPY THIRD_PARTY_LICENSES.md /opt/i2v/licenses/THIRD_PARTY_LICENSES.md

RUN /opt/i2v-venv/bin/python -m pip install \
        --require-hashes \
        --no-deps \
        -r requirements-i2v-face.lock \
    && mkdir --parents /opt/i2v/vendor \
    && /opt/i2v-venv/bin/python -m zipfile \
        -e /tmp/anime-face-detector.whl /opt/i2v/vendor \
    && /opt/i2v-venv/bin/python -m compileall \
        -q /opt/i2v/vendor/anime_face_detector \
    && /opt/i2v-venv/bin/python -c \
        "from pathlib import Path; import cv2; import numpy as np; assert cv2.__version__=='4.14.0'; from PIL import Image; source=Image.open('/tmp/anime-face-detector-input.jpg'); source.crop((0,0,512,512)).save('/tmp/anime-face-detector-smoke.png'); from anime_face_detector.detector import LandmarkDetector; detector=LandmarkDetector('/opt/i2v/face-models/hrnetv2.safetensors',face_detector_name='yolov3',face_detector_checkpoint_path='/opt/i2v/face-models/yolov3.safetensors',device='cpu',flip_test=False); result=detector(Path('/tmp/anime-face-detector-smoke.png')); assert len(result)==1; assert float(result[0]['bbox'][4])>=0.95; assert result[0]['keypoints'].shape==(28,3); confidence=np.asarray(result[0]['keypoints'])[:,2]; assert float(confidence.min())>=0.60; assert float(confidence.mean())>=0.85" \
    && rm -f \
        /tmp/anime-face-detector-input.jpg \
        /tmp/anime-face-detector-smoke.png \
        /tmp/anime-face-detector.whl

LABEL org.opencontainers.image.face-stabilizer="static-source-head-single-blink-v2" \
      org.opencontainers.image.anime-face-detector.revision="${ANIME_FACE_DETECTOR_REVISION}" \
      org.opencontainers.image.anime-face-detector.wheel-sha256="${ANIME_FACE_DETECTOR_WHEEL_SHA256}" \
      org.opencontainers.image.anime-face-detector.yolo-sha256="${ANIME_FACE_YOLO_SHA256}" \
      org.opencontainers.image.anime-face-detector.hrnet-sha256="${ANIME_FACE_HRNET_SHA256}" \
      org.opencontainers.image.opencv-headless.sha256="${OPENCV_HEADLESS_SHA256}"
ENV GEN_I2V_FACE_DETECTOR_YOLO_PATH=/opt/i2v/face-models/yolov3.safetensors \
    GEN_I2V_FACE_LANDMARK_HRNET_PATH=/opt/i2v/face-models/hrnetv2.safetensors \
    HF_HUB_OFFLINE=1

COPY src/gen_automation/__init__.py ./src/gen_automation/__init__.py
COPY src/gen_automation/i2v_worker ./src/gen_automation/i2v_worker
COPY --chmod=0555 scripts/i2v-runpod-entrypoint.sh /opt/i2v/bin/i2v-runpod-entrypoint
COPY workflows/dasiwa-wan22-i2v-v1.api.json ./workflows/dasiwa-wan22-i2v-v1.api.json

RUN groupadd --system --gid 10002 i2v-worker \
    && useradd \
        --system \
        --create-home \
        --uid 10002 \
        --gid i2v-worker \
        --home-dir /home/i2v-worker \
        --shell /usr/sbin/nologin \
        i2v-worker \
    && mkdir --parents \
        /opt/comfyui/models/diffusion_models \
        /opt/comfyui/models/text_encoders \
        /opt/comfyui/models/vae/Wan \
        /opt/comfyui/models/loras \
        /opt/i2v/runtime/input \
        /opt/i2v/runtime/output \
        /opt/i2v/runtime/temp \
        /opt/i2v/runtime/user \
        /opt/i2v/runtime/jobs \
    && chown --recursive 10002:10002 \
        /opt/comfyui/models \
        /opt/i2v/runtime \
        /home/i2v-worker \
    && chmod --recursive go-rwx /opt/comfyui/models /opt/i2v/runtime

RUN command -v find \
    && command -v setpriv \
    && test -x /opt/i2v/bin/i2v-runpod-entrypoint \
    && /bin/bash -n /opt/i2v/bin/i2v-runpod-entrypoint

USER 0:0

ENTRYPOINT ["/opt/i2v/bin/i2v-runpod-entrypoint"]
