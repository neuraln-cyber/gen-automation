# syntax=docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS salad-queue-worker-builder

ENV SALAD_QUEUE_WORKER_COMMIT=73d7a3c80a73f26339194e024cb47c8501c67f75 \
    SALAD_QUEUE_WORKER_PATCH_SHA256=a25fa6ca196554eb1e4b6acaabfb22730db69515d07a8e82585015df4213c0ae \
    SALAD_QUEUE_WORKER_HEARTBEAT_PATCH_SHA256=51d604da546aa076073d971b6839998d3582e34f5f52af64faf4c7c6e8f6f23a \
    SALAD_QUEUE_WORKER_IMDS_PATCH_SHA256=916f22c8075481a2924aabc2f1d1b57d891681eb5bd10b6081487df7b57a336d \
    SALAD_QUEUE_WORKER_SECURITY_PATCH_SHA256=0e6850de22e6fd2006833d5ee2b340bf9e4a6d030a3675ee2afe939f406b3159

RUN apk add --no-cache git \
    && mkdir --parents /src \
    && git -C /src init \
    && git -C /src remote add origin \
        https://github.com/SaladTechnologies/salad-cloud-job-queue-worker.git \
    && git -C /src fetch --depth 1 origin "${SALAD_QUEUE_WORKER_COMMIT}" \
    && git -C /src checkout --detach FETCH_HEAD \
    && test "$(git -C /src rev-parse HEAD)" = "${SALAD_QUEUE_WORKER_COMMIT}"

WORKDIR /src

COPY patches/salad-queue-worker/strict-http-status.patch /tmp/strict-http-status.patch
COPY patches/salad-queue-worker/job-stream-heartbeat-watchdog.patch /tmp/job-stream-heartbeat-watchdog.patch
COPY patches/salad-queue-worker/imds-token-recovery.patch /tmp/imds-token-recovery.patch
COPY patches/salad-queue-worker/security-dependencies.patch /tmp/security-dependencies.patch

RUN printf '%s  %s\n' \
        "${SALAD_QUEUE_WORKER_PATCH_SHA256}" \
        /tmp/strict-http-status.patch \
        "${SALAD_QUEUE_WORKER_HEARTBEAT_PATCH_SHA256}" \
        /tmp/job-stream-heartbeat-watchdog.patch \
        "${SALAD_QUEUE_WORKER_IMDS_PATCH_SHA256}" \
        /tmp/imds-token-recovery.patch \
        "${SALAD_QUEUE_WORKER_SECURITY_PATCH_SHA256}" \
        /tmp/security-dependencies.patch \
        | sha256sum -c - \
    && git apply --unidiff-zero --check /tmp/strict-http-status.patch \
    && git apply --unidiff-zero /tmp/strict-http-status.patch \
    && git apply --check /tmp/job-stream-heartbeat-watchdog.patch \
    && git apply /tmp/job-stream-heartbeat-watchdog.patch \
    && git apply --check /tmp/imds-token-recovery.patch \
    && git apply /tmp/imds-token-recovery.patch \
    && git apply --check /tmp/security-dependencies.patch \
    && git apply /tmp/security-dependencies.patch \
    && git diff --check

RUN go mod download \
    && go mod verify \
    && go test -mod=readonly ./cmd/salad-http-job-queue-worker ./internal/workers \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
        -mod=readonly \
        -trimpath \
        -buildvcs=false \
        -ldflags="-s -w -X github.com/saladtechnologies/salad-cloud-job-queue-worker/pkg/workers.Version=git-${SALAD_QUEUE_WORKER_COMMIT}" \
        -o /out/salad-http-job-queue-worker \
        ./cmd/salad-http-job-queue-worker

FROM pytorch/pytorch:2.9.1-cuda13.0-cudnn9-runtime@sha256:60f22fb80755fd0b470fb47928dbd55816aa9f847edd95cf43c93253507a9ddf

LABEL org.opencontainers.image.title="gen-automation-native-h3-i2v-worker" \
      org.opencontainers.image.description="Model-free native MiniMax H3 Eros and legacy WAN worker" \
      org.opencontainers.image.source="https://github.com/neuraln-cyber/gen-automation" \
      org.opencontainers.image.comfyui.revision="73c9bad4d21e7addbe1d13bc92eee0f1431b017d" \
      org.opencontainers.image.runpod-sdk.version="1.11.0"

ENV DEBIAN_FRONTEND=noninteractive \
    COMFYUI_COMMIT=73c9bad4d21e7addbe1d13bc92eee0f1431b017d \
    VIRTUAL_ENV=/opt/i2v-venv \
    PATH=/opt/i2v-venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/i2v/src:/opt/i2v/vendor \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/i2v-worker

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ADD --checksum=sha256:4747b2d6a8336f52343bceb8a1ebf41a9e6e665b9d2e3f989972de53a310599e \
    --chmod=0444 \
    https://conda.anaconda.org/conda-forge/linux-64/openssl-3.6.4-h781a0a9_0.conda \
    /tmp/openssl-3.6.4-h781a0a9_0.conda

RUN /opt/conda/bin/conda install \
        --yes \
        --offline \
        --no-deps \
        /tmp/openssl-3.6.4-h781a0a9_0.conda \
    && test "$(/opt/conda/bin/openssl version | awk '{print $2}')" = "3.6.4" \
    && /opt/conda/bin/conda clean --all --yes \
    && rm -f /tmp/openssl-3.6.4-h781a0a9_0.conda

# CPython security patch and its exact support-library closure. The CUDA,
# torch and model sources remain immutable; the installer verifies preservation.
ADD --checksum=sha256:fffd5671d70f170924824ae9dc8cab58f72b781ea166745f07daf00c55a54a3d --chmod=0444 \
