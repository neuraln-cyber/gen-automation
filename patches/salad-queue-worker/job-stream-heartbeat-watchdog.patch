--- /dev/null
+++ b/internal/workers/poller_supervisor_test.go
@@ -0,0 +1,72 @@
+package workers
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestJobPollerRestartsWithoutReadinessChange(t *testing.T) {
+	for name, stopped := range map[string]error{
+		"server cancellation returns nil": nil,
+		"server cancellation":             context.Canceled,
+		"missing job":                     errJobNotFound,
+		"transport failure":               errors.New("transport failed"),
+	} {
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			calls := 0
+			err := superviseJobPoller(ctx, func(pollCtx context.Context) error {
+				calls++
+				if pollCtx.Err() != nil {
+					t.Fatal("live poller context canceled during recovery")
+				}
+				if calls == 3 {
+					cancel() // Two recoveries, then an intentional readiness/stop cancel.
+				}
+				return stopped
+			}, time.Millisecond)
+			if !errors.Is(err, context.Canceled) || calls != 3 {
+				t.Fatalf("error=%v calls=%d", err, calls)
+			}
+		})
+	}
+}
+
+func TestJobPollerPreservesTerminalInstanceErrors(t *testing.T) {
+	for _, terminal := range []error{errWorkloadInstanceNotFound, errWorkloadTokenUnavailable} {
+		calls := 0
+		err := superviseJobPoller(context.Background(), func(context.Context) error {
+			calls++
+			return terminal
+		}, time.Millisecond)
+		if err != terminal || calls != 1 {
+			t.Fatalf("error=%v calls=%d", err, calls)
+		}
+	}
+}
+
+func TestJobPollerCancellationInterruptsBackoff(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	called := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		done <- superviseJobPoller(ctx, func(context.Context) error {
+			close(called)
+			return nil
+		}, time.Hour)
+	}()
+	<-called
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("poller ignored cancellation during backoff")
+	}
+}
