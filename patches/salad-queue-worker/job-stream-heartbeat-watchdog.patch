+++ b/internal/workers/poller_integration_test.go
@@ -0,0 +1,93 @@
+package workers
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	queues_api "github.com/saladtechnologies/salad-cloud-job-queue-worker/internal/apis/queues"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type recoveringQueueServer struct {
+	queues_api.UnimplementedJobQueueWorkerServiceServer
+	failure         codes.Code
+	calls           atomic.Int32
+	wrongCurrentJob atomic.Bool
+}
+
+func (s *recoveringQueueServer) AcceptJobs(request *queues_api.AcceptJobsRequest, stream grpc.ServerStreamingServer[queues_api.AcceptJobsResponse]) error {
+	if request.CurrentJobId != "preserved-current-job" {
+		s.wrongCurrentJob.Store(true)
+	}
+	if s.calls.Add(1) == 1 {
+		return status.Error(s.failure, "simulated stream interruption")
+	}
+	if err := stream.Send(&queues_api.AcceptJobsResponse{
+		Message: &queues_api.AcceptJobsResponse_Job{Job: &queues_api.Job{JobId: "next-job"}},
+	}); err != nil {
+		return err
+	}
+	<-stream.Context().Done()
+	return stream.Context().Err()
+}
+
+func TestRealJobStreamRecoversServerErrorsAndPreservesCurrentJob(t *testing.T) {
+	for _, code := range []codes.Code{codes.Canceled, codes.NotFound} {
+		t.Run(code.String(), func(t *testing.T) {
+			metadata := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/v1/token" {
+					http.NotFound(w, r)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"jwt":"test-token"}`))
+			}))
+			defer metadata.Close()
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := grpc.NewServer()
+			service := &recoveringQueueServer{failure: code}
+			queues_api.RegisterJobQueueWorkerServiceServer(server, service)
+			go func() { _ = server.Serve(listener) }()
+			defer server.Stop()
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			conn, err := newQueueConnection(ctx, listener.Addr().String(), false, "test")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			current := &atomic.Pointer[queues_api.Job]{}
+			preserved := &queues_api.Job{JobId: "preserved-current-job"}
+			current.Store(preserved)
+			poller := newJobPoller(newMetadataClient(metadata.URL), conn, current)
+			done := make(chan error, 1)
+			go func() { done <- superviseJobPoller(ctx, poller.poll, time.Millisecond) }()
+			select {
+			case job := <-poller.next():
+				if job.JobId != "next-job" {
+					t.Fatal("wrong job after reconnect")
+				}
+			case <-ctx.Done():
+				t.Fatal("listener stayed alive but never accepted the next job")
+			}
+			if service.calls.Load() != 2 || current.Load() != preserved || service.wrongCurrentJob.Load() {
+				t.Fatal("recovery changed the executing job or did not reconnect once")
+			}
+			cancel()
+			if err := <-done; !errors.Is(err, context.Canceled) {
+				t.Fatal(err)
+			}
+		})
+	}
+}
diff --git a/internal/workers/poller_supervisor.go b/internal/workers/poller_supervisor.go
new file mode 100644
index 0000000..79554f7
--- /dev/null
+++ b/internal/workers/poller_supervisor.go
@@ -0,0 +1,44 @@
+package workers
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/saladtechnologies/salad-cloud-job-queue-worker/pkg/log"
+)
+
+// A server-side cancellation may make poll return nil (the parent context is
+// still live). NotFound also used to leave Run holding a non-nil cancel handle
+// for a goroutine that had stopped. Neither case can wait for a readiness edge:
+// an idle, healthy container may stay ready indefinitely.
+// Reconnect without canceling the worker, its HTTP executor, or currentJob.
+func superviseJobPoller(ctx context.Context, poll func(context.Context) error, minimumDelay time.Duration) error {
+	delay := minimumDelay
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		started := time.Now()
+		err := poll(ctx)
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		if errors.Is(err, errWorkloadInstanceNotFound) || errors.Is(err, errWorkloadTokenUnavailable) {
+			return err // Preserve the existing terminal instance/auth handling.
+		}
+		if time.Since(started) >= time.Minute {
+			delay = minimumDelay
+		}
+		// Do not log upstream errors: they can include tokens or job payloads.
+		log.FromContext(ctx).Warn("job poller stopped; reconnecting", "retry_delay", delay)
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		case <-timer.C:
+		}
+		delay = min(delay*2, time.Minute)
+	}
+}
