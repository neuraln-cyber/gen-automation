GEN_AUTOMATION_ENVIRONMENT=local
GEN_AUTOMATION_LOG_LEVEL=INFO
GEN_AUTOMATION_PUBLIC_BASE_URL=http://127.0.0.1:8000
GEN_AUTOMATION_DATABASE_URL=postgresql+psycopg://gen_automation:change-me@postgres:5432/gen_automation
# Unpadded base64url encoding of a random 32-byte key.
GEN_AUTOMATION_SESSION_SECRET=
GEN_AUTOMATION_AUTO_CREATE_SCHEMA=false
GEN_AUTOMATION_AUTH_ENABLED=false
# Synthetic local owner access. Keep false unless the process is an intentionally
# isolated LOCAL/TEST instance; it is mutually exclusive with AUTH_ENABLED.
GEN_AUTOMATION_AUTH_DEVELOPMENT_BYPASS_ENABLED=false
GEN_AUTOMATION_AUTH_REQUIRE_TOTP=true
GEN_AUTOMATION_AUTH_TOTP_ACTIVE_KEY_ID=totp-key-1
# JSON keyring. Retain old keys while re-encrypting enrolled TOTP seeds.
GEN_AUTOMATION_AUTH_TOTP_ENCRYPTION_KEYS={}
# Conservative defaults for shared/local examples. The single-owner staging
# profile in infra/aws-staging/deploy/control-plane.env.example opts into longer
# bounded sessions while retaining password, TOTP, CSRF, and server-side expiry.
GEN_AUTOMATION_AUTH_SESSION_ABSOLUTE_SECONDS=43200
GEN_AUTOMATION_AUTH_SESSION_IDLE_SECONDS=1800
GEN_AUTOMATION_AUTH_RECENT_AUTH_SECONDS=600
GEN_AUTOMATION_AUTH_LOGIN_WINDOW_SECONDS=900
GEN_AUTOMATION_AUTH_LOGIN_MAX_FAILURES=5
GEN_AUTOMATION_AUTH_LOGIN_LOCKOUT_SECONDS=900
# Normal administrator invite capabilities expire after this bounded interval.
GEN_AUTOMATION_AUTH_ENROLLMENT_INVITE_TTL_SECONDS=86400
# JSON array of exact proxy networks allowed to supply X-Forwarded-For. Use the
# narrow TLS-ingress/source ranges for each environment; /0 is rejected.
GEN_AUTOMATION_TRUSTED_PROXY_CIDRS=[]
# Protected startup assertion: set true only after ingress authentication/login
# rate limits have been deployed and verified outside this plain-HTTP container.
GEN_AUTOMATION_INGRESS_RATE_LIMIT_CONFIGURED=false
# Protected startup assertion: set true only after ingress enforces bounded
# request bodies and headers, connection concurrency, and request timeouts,
# including chunked requests without Content-Length.
GEN_AUTOMATION_INGRESS_REQUEST_GUARDS_CONFIGURED=false
GEN_AUTOMATION_BACKGROUND_RUNTIME_ENABLED=false
GEN_AUTOMATION_BACKGROUND_POLL_INTERVAL_SECONDS=2
GEN_AUTOMATION_BACKGROUND_ERROR_BACKOFF_MAX_SECONDS=60
GEN_AUTOMATION_BACKGROUND_SUBMIT_TIMEOUT_SECONDS=180
GEN_AUTOMATION_BACKGROUND_DEPLOYMENT_TIMEOUT_SECONDS=180
GEN_AUTOMATION_BACKGROUND_RECONCILE_TIMEOUT_SECONDS=180
GEN_AUTOMATION_BACKGROUND_INBOX_TIMEOUT_SECONDS=30
GEN_AUTOMATION_BACKGROUND_COLLECTION_TIMEOUT_SECONDS=300
# Automatic CPU scoring is opt-in and requires both object storage and the
# background runtime. Production executes one exact-version master at a time.
GEN_AUTOMATION_QUALITY_SCORING_ENABLED=false
GEN_AUTOMATION_BACKGROUND_QUALITY_TIMEOUT_SECONDS=75
GEN_AUTOMATION_BACKGROUND_QUALITY_ANALYSIS_TIMEOUT_SECONDS=45
GEN_AUTOMATION_BACKGROUND_QUALITY_MEMORY_LIMIT_BYTES=805306368
GEN_AUTOMATION_BACKGROUND_QUALITY_LEASE_SECONDS=120
GEN_AUTOMATION_BACKGROUND_QUALITY_MAX_ATTEMPTS=3
GEN_AUTOMATION_BACKGROUND_QUALITY_RETRY_BASE_SECONDS=30
GEN_AUTOMATION_BACKGROUND_QUALITY_RETRY_MAX_SECONDS=900
# Optional burst/scale-to-zero semantic anatomy QC. No second GPU is required
# unless this flag is enabled. The endpoint is a private implementation of
# semantic-anatomy-assessment/v1; pin the exact deployed model revision.
GEN_AUTOMATION_SEMANTIC_ANATOMY_ENABLED=false
GEN_AUTOMATION_SEMANTIC_ANATOMY_ENDPOINT_URL=
GEN_AUTOMATION_SEMANTIC_ANATOMY_MODEL=Qwen/Qwen3-VL-8B-Instruct
GEN_AUTOMATION_SEMANTIC_ANATOMY_MODEL_REVISION=
GEN_AUTOMATION_SEMANTIC_ANATOMY_SEVERE_CONFIDENCE_MICROS=900000
GEN_AUTOMATION_BACKGROUND_SEMANTIC_TIMEOUT_SECONDS=210
GEN_AUTOMATION_BACKGROUND_SEMANTIC_REQUEST_TIMEOUT_SECONDS=180
GEN_AUTOMATION_BACKGROUND_SEMANTIC_LEASE_SECONDS=300
GEN_AUTOMATION_BACKGROUND_SEMANTIC_MAX_ATTEMPTS=3
GEN_AUTOMATION_BACKGROUND_SEMANTIC_RETRY_BASE_SECONDS=60
GEN_AUTOMATION_BACKGROUND_SEMANTIC_RETRY_MAX_SECONDS=1800
GEN_AUTOMATION_DERIVATIVE_RENDERING_ENABLED=false
GEN_AUTOMATION_BACKGROUND_DERIVATIVE_TIMEOUT_SECONDS=150
GEN_AUTOMATION_BACKGROUND_DERIVATIVE_RENDER_TIMEOUT_SECONDS=120
GEN_AUTOMATION_BACKGROUND_DERIVATIVE_MEMORY_LIMIT_BYTES=536870912
GEN_AUTOMATION_BACKGROUND_DERIVATIVE_LEASE_SECONDS=300
GEN_AUTOMATION_BACKGROUND_DERIVATIVE_RETRY_BASE_SECONDS=30
GEN_AUTOMATION_BACKGROUND_DERIVATIVE_RETRY_MAX_SECONDS=900
# Durable publication runner. This only claims approved intents; the database
# publication guard is separately initialized STOPPED and must be enabled by an
# authenticated OWNER. Patreon packages need no provider credential. X effects
# remain fail-closed until both the exact full AWS Secrets Manager reference and
# numeric creator user ID below are configured. The controller uses ambient AWS
# workload identity; do not add static AWS credentials here.
GEN_AUTOMATION_BACKGROUND_PUBLICATION_TIMEOUT_SECONDS=300
GEN_AUTOMATION_BACKGROUND_PUBLICATION_LEASE_SECONDS=600
GEN_AUTOMATION_BACKGROUND_PUBLICATION_RETRY_BASE_SECONDS=30
GEN_AUTOMATION_BACKGROUND_PUBLICATION_RETRY_MAX_SECONDS=900
GEN_AUTOMATION_BACKGROUND_PUBLICATION_MAX_PACKAGE_BYTES=167772160
# Optional official-UI publisher. The profile reference is an opaque directory
# name, not a credential. The signed-in Chromium profile itself is mounted only
# into the isolated sidecar. Disabled keeps the deterministic manual ZIP flow.
GEN_AUTOMATION_PATREON_BROWSER_PUBLISHING_ENABLED=false
GEN_AUTOMATION_PATREON_BROWSER_SIDECAR_URL=http://patreon-browser:8090/v1/publish
GEN_AUTOMATION_PATREON_BROWSER_PROFILE_REFERENCE=creator-main
# Inject the same random 32+ byte value into the controller and sidecar from
# deployment secret storage. Never commit the value.
GEN_AUTOMATION_PATREON_BROWSER_SHARED_SECRET=
GEN_AUTOMATION_PATREON_BROWSER_TIMEOUT_SECONDS=240
# Optional automatic mirror of the finished, clean Patreon ZIP. This path is
# not a credential: it points at a private volume containing a profile that an
# operator authenticated once with official MEGAcmd. Never put an email,
# password, session ID, folder key, or writable auth-key in this file.
GEN_AUTOMATION_MEGA_DELIVERY_ENABLED=false
GEN_AUTOMATION_MEGA_PROFILE_HOME=/run/gen-automation/mega-profile
GEN_AUTOMATION_MEGA_REMOTE_ROOT=/AutomatedSets
GEN_AUTOMATION_BACKGROUND_MEGA_TIMEOUT_SECONDS=660
GEN_AUTOMATION_BACKGROUND_MEGA_COMMAND_TIMEOUT_SECONDS=300
GEN_AUTOMATION_BACKGROUND_MEGA_LEASE_SECONDS=900
GEN_AUTOMATION_BACKGROUND_MEGA_RETRY_BASE_SECONDS=300
GEN_AUTOMATION_BACKGROUND_MEGA_RETRY_MAX_SECONDS=3600
GEN_AUTOMATION_BACKGROUND_MEGA_MAX_PACKAGE_BYTES=167772160
GEN_AUTOMATION_X_CREATOR_USER_ID=
GEN_AUTOMATION_X_OAUTH_SECRET_REFERENCE=
GEN_AUTOMATION_X_OAUTH_REQUEST_TIMEOUT_SECONDS=30
GEN_AUTOMATION_X_OAUTH_LOCK_TIMEOUT_SECONDS=15
GEN_AUTOMATION_X_OAUTH_REFRESH_MARGIN_SECONDS=300
GEN_AUTOMATION_BACKGROUND_OUTBOX_LEASE_SECONDS=300
GEN_AUTOMATION_BACKGROUND_INBOX_LEASE_SECONDS=120
GEN_AUTOMATION_BACKGROUND_COLLECTION_LEASE_SECONDS=900
GEN_AUTOMATION_BACKGROUND_RECONCILIATION_INTERVAL_SECONDS=30
GEN_AUTOMATION_BACKGROUND_RETRY_DELAY_SECONDS=60
GEN_AUTOMATION_BACKGROUND_SHUTDOWN_GRACE_SECONDS=30
GEN_AUTOMATION_BACKGROUND_SHUTDOWN_CANCEL_SECONDS=5
GEN_AUTOMATION_BACKGROUND_READINESS_FAILURE_THRESHOLD=3
GEN_AUTOMATION_BACKGROUND_LIVENESS_FAILURE_THRESHOLD=10
GEN_AUTOMATION_BACKGROUND_LOOP_STALE_AFTER_SECONDS=900
GEN_AUTOMATION_GPU_ALLOCATION_ENABLED=false
GEN_AUTOMATION_PUBLISHING_ENABLED=false
GEN_AUTOMATION_SALAD_ENABLED=false
GEN_AUTOMATION_SALAD_API_BASE_URL=https://api.salad.com/api/public
GEN_AUTOMATION_SALAD_API_KEY=
GEN_AUTOMATION_SALAD_ORGANIZATION=
GEN_AUTOMATION_SALAD_PROJECT=
GEN_AUTOMATION_SALAD_QUEUE_NAME=comfyui-jobs-v1
GEN_AUTOMATION_SALAD_CONTAINER_GROUP_NAME=comfyui-worker-v1
GEN_AUTOMATION_SALAD_WEBHOOK_SECRET=
GEN_AUTOMATION_SALAD_WORKER_IMAGE=
GEN_AUTOMATION_WORKER_SIGNING_KEY_ID=worker-key-1
# Unpadded base64url encoding of the controller-only 32-byte Ed25519 private key.
GEN_AUTOMATION_WORKER_SIGNING_PRIVATE_KEY=
GEN_AUTOMATION_WORKER_SIGNATURE_TTL_SECONDS=7200
GEN_AUTOMATION_WORKER_UPLOAD_GRANT_TTL_SECONDS=10800
# Controller inputs for the Salad worker runtime resolver. In AWS
# staging/production, set the nonsecret exact reader-role ARN and leave the
# endpoint plus static credential fields blank. The controller assumes the role
# immediately before group creation and every pre-submit group refresh.
GEN_AUTOMATION_SALAD_WORKER_ALLOWED_UPLOAD_ORIGIN=
GEN_AUTOMATION_SALAD_WORKER_MODEL_MANIFEST_JSON=
GEN_AUTOMATION_SALAD_WORKER_MODEL_MANIFEST_SHA256=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_BUCKET=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_REGION=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_ROLE_ARN=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_ENDPOINT_URL=
# Static credentials remain available only for non-role local/test providers.
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_ACCESS_KEY_ID=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_SECRET_ACCESS_KEY=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_SESSION_TOKEN=
GEN_AUTOMATION_SALAD_REQUEST_TIMEOUT_SECONDS=30
GEN_AUTOMATION_SALAD_WEBHOOK_MAX_BODY_BYTES=262144
GEN_AUTOMATION_SALAD_MAX_REPLICAS=1
GEN_AUTOMATION_SALAD_MAX_QUEUED_JOBS=1
# JSON array of one or more GPU class UUIDs selected from Salad's current
# organization GPU-class listing. Keep only classes whose capacity/cost you accept.
GEN_AUTOMATION_SALAD_GPU_CLASS_IDS=[]
GEN_AUTOMATION_SALAD_CONTAINER_CPU=4
GEN_AUTOMATION_SALAD_CONTAINER_MEMORY_MB=16384
GEN_AUTOMATION_SALAD_CONTAINER_STORAGE_BYTES=53687091200
# Conservative per-replica accounting ceiling; set at or above the most
# expensive selected GPU's configured-priority hourly rate.
GEN_AUTOMATION_SALAD_MAX_HOURLY_COST_USD=1.00
GEN_AUTOMATION_SALAD_DAILY_BUDGET_USD=25.00
GEN_AUTOMATION_SALAD_MONTHLY_BUDGET_USD=250.00
GEN_AUTOMATION_STORAGE_ENABLED=false
GEN_AUTOMATION_STORAGE_ENDPOINT_URL=
GEN_AUTOMATION_STORAGE_REGION=us-east-1
GEN_AUTOMATION_STORAGE_BUCKET=
GEN_AUTOMATION_STORAGE_ACCESS_KEY_ID=
GEN_AUTOMATION_STORAGE_SECRET_ACCESS_KEY=
# Optional short-lived STS/session credential; it is valid only with the
# explicit access-key ID and secret above. Leave all three empty for workload identity.
GEN_AUTOMATION_STORAGE_SESSION_TOKEN=
GEN_AUTOMATION_STORAGE_PRESIGN_TTL_SECONDS=10800
GEN_AUTOMATION_STORAGE_VERIFICATION_LEASE_SECONDS=900
GEN_AUTOMATION_STORAGE_MAX_IMAGE_BYTES=104857600

# GPU worker runtime ---------------------------------------------------------
# These values are not required for local control-plane development. Leave the
# secret values empty until the staging worker is deployed, then inject them
# through the staging secret store/Salad runtime bindings rather than a checked-in
# .env file. Complex GEN_WORKER_* values use JSON.
GEN_WORKER_ENVIRONMENT=production
# JSON object of key ID to unpadded base64url Ed25519 public key. Never place the
# controller private key in a worker/container setting.
GEN_WORKER_VERIFICATION_KEYS=
GEN_WORKER_ALLOWED_UPLOAD_ORIGIN=
GEN_WORKER_MODEL_MANIFEST_JSON=
GEN_WORKER_MODEL_MANIFEST_SHA256=

# Private, read-only S3-compatible model-artifact source. Use a worker identity
# that can GetObject only for the approved model prefix; it must not have list,
# write, archive, master, or staging-output permissions.
GEN_WORKER_ARTIFACT_BUCKET=
GEN_WORKER_ARTIFACT_REGION=us-east-1
GEN_WORKER_ARTIFACT_ENDPOINT_URL=
GEN_WORKER_ARTIFACT_ACCESS_KEY_ID=
GEN_WORKER_ARTIFACT_SECRET_ACCESS_KEY=
GEN_WORKER_ARTIFACT_SESSION_TOKEN=
GEN_WORKER_ARTIFACT_CONNECT_TIMEOUT_SECONDS=10
GEN_WORKER_ARTIFACT_READ_TIMEOUT_SECONDS=120
GEN_WORKER_MODEL_BOOTSTRAP_TIMEOUT_SECONDS=3600

# Pinned container paths and internal services.
GEN_WORKER_CHECKPOINT_ROOT=/opt/comfyui/models/checkpoints
GEN_WORKER_LORA_ROOT=/opt/comfyui/models/loras
GEN_WORKER_COMFY_BASE_URL=http://127.0.0.1:8188
GEN_WORKER_COMFY_PYTHON=/opt/worker-venv/bin/python
GEN_WORKER_COMFY_MAIN=/opt/comfyui/main.py
GEN_WORKER_COMFY_RUNTIME_ROOT=/opt/worker/runtime
GEN_WORKER_COMFY_EXECUTION_TIMEOUT_SECONDS=3600
GEN_WORKER_SALAD_QUEUE_WORKER_ENABLED=true
GEN_WORKER_SALAD_QUEUE_WORKER_PATH=/usr/local/bin/salad-http-job-queue-worker
GEN_WORKER_SALAD_QUEUE_WORKER_LOG_LEVEL=error
GEN_WORKER_WORKER_HOST=0.0.0.0
GEN_WORKER_WORKER_PORT=8000
GEN_WORKER_WORKER_LOG_LEVEL=info

# Request, output, and workflow guardrails. The approved-node value is a JSON
# array; change it only with the pinned workflow/custom-node review.
GEN_WORKER_MAX_BODY_BYTES=262144
GEN_WORKER_MAX_SIGNATURE_TTL_SECONDS=7200
GEN_WORKER_CLOCK_SKEW_SECONDS=15
GEN_WORKER_MAX_OUTPUTS=25
GEN_WORKER_MAX_OUTPUT_BYTES=26214400
GEN_WORKER_MAX_TOTAL_OUTPUT_BYTES=104857600
GEN_WORKER_MAX_IMAGE_DIMENSION=16384
GEN_WORKER_MAX_IMAGE_PIXELS=64000000
GEN_WORKER_MAX_REPLAY_ENTRIES=256
GEN_WORKER_UPLOAD_TIMEOUT_SECONDS=120
GEN_WORKER_READINESS_TIMEOUT_SECONDS=1
GEN_WORKER_APPROVED_WORKFLOW_NODE_CLASSES=["CheckpointLoaderSimple","CLIPSetLastLayer","CLIPTextEncode","EmptyLatentImage","FaceDetailer","KSampler","LatentUpscaleBy","LoraLoader","SaveImage","SaveImageWebsocket","UltralyticsDetectorProvider","VAEDecode"]
