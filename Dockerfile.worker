# syntax=docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM golang:1.26.2-alpine@sha256:f85330846cde1e57ca9ec309382da3b8e6ae3ab943d2739500e08c86393a21b1 AS salad-queue-worker-builder

ENV SALAD_QUEUE_WORKER_COMMIT=73d7a3c80a73f26339194e024cb47c8501c67f75 \
    SALAD_QUEUE_WORKER_PATCH_SHA256=a25fa6ca196554eb1e4b6acaabfb22730db69515d07a8e82585015df4213c0ae

RUN apk add --no-cache git \
    && mkdir --parents /src \
    && git -C /src init \
    && git -C /src remote add origin \
        https://github.com/SaladTechnologies/salad-cloud-job-queue-worker.git \
    && git -C /src fetch --depth 1 origin "${SALAD_QUEUE_WORKER_COMMIT}" \
    && git -C /src checkout --detach FETCH_HEAD \
    && test "$(git -C /src rev-parse HEAD)" = "${SALAD_QUEUE_WORKER_COMMIT}"

WORKDIR /src

COPY patches/salad-queue-worker/strict-http-status.patch /tmp/strict-http-status.patch

RUN printf '%s  %s\n' \
        "${SALAD_QUEUE_WORKER_PATCH_SHA256}" \
        /tmp/strict-http-status.patch \
        | sha256sum -c - \
    && git apply --unidiff-zero --check /tmp/strict-http-status.patch \
    && git apply --unidiff-zero /tmp/strict-http-status.patch \
    && git diff --check

RUN go mod download \
    && go mod verify \
    && go test -mod=readonly ./cmd/salad-http-job-queue-worker \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
        -mod=readonly \
        -trimpath \
        -buildvcs=false \
        -ldflags="-s -w -X github.com/saladtechnologies/salad-cloud-job-queue-worker/pkg/workers.Version=git-${SALAD_QUEUE_WORKER_COMMIT}" \
        -o /out/salad-http-job-queue-worker \
        ./cmd/salad-http-job-queue-worker

FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be

LABEL org.opencontainers.image.title="gen-automation-gpu-worker" \
      org.opencontainers.image.description="Ephemeral verified ComfyUI generation worker" \
      org.opencontainers.image.source="https://github.com/neuraln-cyber/gen-automation" \
      org.opencontainers.image.comfyui.revision="700821e1364eaab0e8f21c538a2131719fec57bf" \
      org.opencontainers.image.impact-pack.revision="429d0159ad429e64d2b3916e6e7be9c22d025c3c" \
      org.opencontainers.image.impact-subpack.revision="50c7b71a6a224734cc9b21963c6d1926816a97f1" \
      org.opencontainers.image.salad-queue-worker.revision="73d7a3c80a73f26339194e024cb47c8501c67f75" \
      org.opencontainers.image.salad-queue-worker.patch-sha256="a25fa6ca196554eb1e4b6acaabfb22730db69515d07a8e82585015df4213c0ae"

ENV DEBIAN_FRONTEND=noninteractive \
    COMFYUI_COMMIT=700821e1364eaab0e8f21c538a2131719fec57bf \
    IMPACT_PACK_COMMIT=429d0159ad429e64d2b3916e6e7be9c22d025c3c \
    IMPACT_SUBPACK_COMMIT=50c7b71a6a224734cc9b21963c6d1926816a97f1 \
    VIRTUAL_ENV=/opt/worker-venv \
    PATH=/opt/worker-venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/worker/src \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && mkdir --parents /opt/comfyui \
    && git -C /opt/comfyui init \
    && git -C /opt/comfyui remote add origin https://github.com/Comfy-Org/ComfyUI.git \
    && git -C /opt/comfyui fetch --depth 1 origin "${COMFYUI_COMMIT}" \
    && git -C /opt/comfyui checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/comfyui rev-parse HEAD)" = "${COMFYUI_COMMIT}" \
    && mkdir --parents /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack init \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack remote add origin \
        https://github.com/ltdrdata/ComfyUI-Impact-Pack.git \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack fetch \
        --depth 1 origin "${IMPACT_PACK_COMMIT}" \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack rev-parse HEAD)" = \
        "${IMPACT_PACK_COMMIT}" \
    && touch /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack/skip_download_model \
    && mkdir --parents /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack init \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack remote add origin \
        https://github.com/ltdrdata/ComfyUI-Impact-Subpack.git \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack fetch \
        --depth 1 origin "${IMPACT_SUBPACK_COMMIT}" \
    && git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack rev-parse HEAD)" = \
        "${IMPACT_SUBPACK_COMMIT}" \
    && rm -rf /opt/comfyui/.git \
        /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack/.git \
        /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack/.git \
    && apt-get purge --yes --auto-remove git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/worker

COPY requirements.lock requirements-comfy.lock requirements-worker-base.txt ./

RUN python -c "import sys; assert sys.version_info[:2] == (3, 12)" \
    && python -m venv \
        --copies \
        --without-pip \
        --system-site-packages \
        /opt/worker-venv \
    && test -x /opt/worker-venv/bin/python \
    && /opt/worker-venv/bin/python -c "import sys; assert sys.version_info[:2] == (3, 12); assert sys.prefix == '/opt/worker-venv'; assert sys.prefix != sys.base_prefix" \
    && /opt/worker-venv/bin/python -m pip install --only-binary=:all: --require-hashes --no-deps -r requirements.lock \
    && /opt/worker-venv/bin/python -m pip install --only-binary=:all: --require-hashes --no-deps -r requirements-comfy.lock \
    && /opt/worker-venv/bin/python -c "import cv2, dill, matplotlib, piexif, segment_anything, skimage, ultralytics; import torch, torchaudio, torchvision; assert all('/opt/worker-venv/' not in module.__file__ for module in (torch, torchaudio, torchvision)); assert torch.__version__.split('+')[0] == '2.11.0'; assert torchvision.__version__.split('+')[0] == '0.26.0'; assert torchaudio.__version__.split('+')[0] == '2.11.0'" \
    && grep -Fq '"FaceDetailer": FaceDetailer' \
        /opt/comfyui/custom_nodes/ComfyUI-Impact-Pack/__init__.py \
    && grep -Fq '"UltralyticsDetectorProvider": UltralyticsDetectorProvider' \
        /opt/comfyui/custom_nodes/ComfyUI-Impact-Subpack/modules/subpack_nodes.py

COPY src/gen_automation/__init__.py ./src/gen_automation/__init__.py
COPY src/gen_automation/gpu_worker ./src/gen_automation/gpu_worker
COPY src/gen_automation/domain/__init__.py ./src/gen_automation/domain/__init__.py
COPY src/gen_automation/domain/deliverability.py ./src/gen_automation/domain/deliverability.py
COPY src/gen_automation/domain/generation_limits.py ./src/gen_automation/domain/generation_limits.py
COPY src/gen_automation/domain/signing.py ./src/gen_automation/domain/signing.py
COPY --from=salad-queue-worker-builder --chmod=0555 \
    /out/salad-http-job-queue-worker \
    /usr/local/bin/salad-http-job-queue-worker

RUN groupadd --system --gid 10001 worker \
    && useradd \
        --system \
        --create-home \
        --uid 10001 \
        --gid worker \
        --home-dir /home/worker \
        --shell /usr/sbin/nologin \
        worker \
    && mkdir --parents \
        /opt/comfyui/models/checkpoints \
        /opt/comfyui/models/loras \
        /opt/comfyui/models/ultralytics/bbox \
        /opt/worker/runtime \
    && chown --recursive 10001:10001 \
        /opt/comfyui/models/checkpoints \
        /opt/comfyui/models/loras \
        /opt/comfyui/models/ultralytics/bbox \
        /opt/worker/runtime

ENV HOME=/home/worker

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=3s --start-period=60m --retries=3 \
    CMD ["/opt/worker-venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).read()"]

ENTRYPOINT ["/opt/worker-venv/bin/python", "-m", "gen_automation.gpu_worker.main"]
