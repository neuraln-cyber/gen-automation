# Non-secret example values. Copy to terraform.tfvars (gitignored) and edit.
aws_region         = "eu-central-1"
name_prefix        = "gen-automation-staging"
notification_email = "operator@example.com"
monthly_budget_usd = 100
budget_enabled      = true

# Only abandoned presigned-upload attempts under staging/ expire. Raw masters,
# derivatives, finished-set archives, and publication packages remain durable.
abandoned_staging_retention_days = 7

# Organizations member accounts can be denied budget creation until the payer
# enables cost management. In that case set budget_enabled = false and create
# a management-account budget filtered to this linked account.

# Leave both null for an IP-only infrastructure canary. Set both together
# before Caddy obtains a public certificate and the dashboard uses S3 CORS.
route53_zone_id = null
hostname        = null
browser_upload_origin = null

# Reference an existing complete secret only after its JSON has been created
# outside OpenTofu. Never put the X OAuth JSON or token values in tfvars.
x_oauth_secret_arn = null
x_oauth_auth_mode  = "oauth2"

# Existing API-key secret used only by the CPU-side Civitai importer. The
# secret value never enters OpenTofu state or the browser.
civitai_api_secret_arn = null

# Map only exact immutable S3 object versions. The reviewed I2V source manifest
# is pinned because the host-side rollout verifier reads that exact VersionId;
# add model objects only after their separate artifact review.
salad_worker_artifact_object_versions = {
  "worker/i2v/manifests/sha256/f0cd579606c8bc7fbf77ee8353b5c542395576d08f21e9acea37a1e2de19876e.json" = "u4bSnCPzDJ4zctrA2Nr66ji0Zh2qPpXX"
  # "worker/checkpoints/example-sha256.safetensors" = "opaque-s3-version-id"
  # "worker/diffusion-models/example-sha256.safetensors" = "opaque-s3-version-id"
  # "worker/text-encoders/example-sha256.safetensors" = "opaque-s3-version-id"
  # "worker/vae/example-sha256.safetensors" = "opaque-s3-version-id"
  # "worker/i2v/sha256/<exact-64-hex-sha256>" = "opaque-s3-version-id"
}

# Keep empty until the compact inline policy reaches its hard IAM quota. Entries
# here remain exact key + exact VersionId reads in one additive managed policy.
salad_worker_artifact_extension_object_versions = {}

# Exchange GitHub's main-branch OIDC token for a short-lived, exact-instance
# SSM deploy role. This avoids AWS access keys and routine AWS browser logins.
github_actions_deploy_enabled            = true
github_actions_repository                = "neuraln-cyber/gen-automation"
github_actions_repository_owner_id       = 310034173
github_actions_repository_id             = 1314605368

# Leave null when this module should create the account's GitHub OIDC provider.
# If one already exists, set its exact ARN to reference and validate it instead.
github_actions_oidc_provider_arn = null

# Defaults implement ADR 0002. These explicit examples make cost-affecting
# changes visible during review.
instance_type                  = "t3a.medium"
root_volume_gib                = 40
integration_profile_volume_gib = 8
db_instance_class              = "db.t4g.micro"
db_allocated_storage_gib       = 20
postgres_engine_version        = "17.10"
db_deletion_protection         = true
db_skip_final_snapshot         = false

http_ingress_cidrs = ["0.0.0.0/0"]

tags = {
  Owner = "creator"
}
