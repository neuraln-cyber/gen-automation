# Copy to /etc/gen-automation/semantic-gateway.env with mode 0600 and root ownership.
# The upstream must be one exact official staging RunPod vLLM endpoint. Keep its
# API key only in the root-owned host copy; never commit it or place it in deploy.env.
GEN_AUTOMATION_SEMANTIC_GATEWAY_UPSTREAM_CHAT_COMPLETIONS_URL=
GEN_AUTOMATION_SEMANTIC_GATEWAY_MODEL=Qwen/Qwen3-VL-8B-Instruct
GEN_AUTOMATION_SEMANTIC_GATEWAY_MODEL_REVISION=60595ebc30ec8e3b1d3b9e65d4943ca011c0006a
GEN_AUTOMATION_SEMANTIC_GATEWAY_UPSTREAM_API_KEY=
GEN_AUTOMATION_SEMANTIC_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=600
GEN_AUTOMATION_SEMANTIC_GATEWAY_UPSTREAM_MAX_TOKENS=512
GEN_AUTOMATION_SEMANTIC_GATEWAY_MAX_IMAGE_BYTES=12582912
GEN_AUTOMATION_SEMANTIC_GATEWAY_MAX_UPSTREAM_RESPONSE_BYTES=131072
