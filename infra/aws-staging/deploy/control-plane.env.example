# Copy to /etc/gen-automation/control-plane.env with mode 0600 and root ownership.
# Blank entries are placeholders. Populate secrets only on the staging host.
GEN_AUTOMATION_ENVIRONMENT=staging
GEN_AUTOMATION_DATABASE_URL=
GEN_AUTOMATION_PUBLIC_BASE_URL=
GEN_AUTOMATION_SESSION_SECRET=
GEN_AUTOMATION_AUTO_CREATE_SCHEMA=false

GEN_AUTOMATION_AUTH_ENABLED=true
GEN_AUTOMATION_AUTH_REQUIRE_TOTP=true
GEN_AUTOMATION_AUTH_TOTP_ACTIVE_KEY_ID=totp-key-1
GEN_AUTOMATION_AUTH_TOTP_ENCRYPTION_KEYS={}
# Single-owner staging profile: sign in at least once every 30 days to keep the
# sliding idle window active; the opaque server-side session expires after 90
# days regardless. Sensitive actions require password + TOTP again after 1 hour.
GEN_AUTOMATION_AUTH_SESSION_ABSOLUTE_SECONDS=7776000
GEN_AUTOMATION_AUTH_SESSION_IDLE_SECONDS=2592000
GEN_AUTOMATION_AUTH_RECENT_AUTH_SECONDS=3600
GEN_AUTOMATION_TRUSTED_PROXY_CIDRS=["127.0.0.1/32"]
GEN_AUTOMATION_INGRESS_RATE_LIMIT_CONFIGURED=true
GEN_AUTOMATION_INGRESS_REQUEST_GUARDS_CONFIGURED=true

GEN_AUTOMATION_BACKGROUND_RUNTIME_ENABLED=true
GEN_AUTOMATION_LORA_MANAGER_ENABLED=false
# Populated by the explicit reviewed promotion from the exact non-secret staging ARN.
# Never put the Civitai API key itself in this file or in GitHub Actions.
GEN_AUTOMATION_CIVITAI_API_SECRET_REFERENCE=
GEN_AUTOMATION_QUALITY_SCORING_ENABLED=true
GEN_AUTOMATION_DERIVATIVE_RENDERING_ENABLED=true
GEN_AUTOMATION_SEMANTIC_ANATOMY_ENABLED=false
GEN_AUTOMATION_SEMANTIC_ANATOMY_MODE=shadow
GEN_AUTOMATION_SEMANTIC_ANATOMY_ENDPOINT_URL=http://127.0.0.1:8091/v1/anatomy/assess
GEN_AUTOMATION_SEMANTIC_ANATOMY_MODEL=Qwen/Qwen3-VL-8B-Instruct
GEN_AUTOMATION_SEMANTIC_ANATOMY_MODEL_REVISION=60595ebc30ec8e3b1d3b9e65d4943ca011c0006a
GEN_AUTOMATION_SEMANTIC_ANATOMY_MAX_ASSESSMENTS_PER_PROFILE=0
GEN_AUTOMATION_SEMANTIC_ANATOMY_ASSET_ALLOWLIST=[]
GEN_AUTOMATION_SEMANTIC_ANATOMY_SEVERE_CONFIDENCE_MICROS=900000
GEN_AUTOMATION_SEMANTIC_LEARNING_ENABLED=true
GEN_AUTOMATION_BACKGROUND_SEMANTIC_LEARNING_TIMEOUT_SECONDS=300
GEN_AUTOMATION_BACKGROUND_SEMANTIC_LEARNING_LEASE_SECONDS=600
GEN_AUTOMATION_BACKGROUND_SEMANTIC_TIMEOUT_SECONDS=660
GEN_AUTOMATION_BACKGROUND_SEMANTIC_REQUEST_TIMEOUT_SECONDS=630
GEN_AUTOMATION_BACKGROUND_SEMANTIC_LEASE_SECONDS=720
GEN_AUTOMATION_BACKGROUND_SEMANTIC_MAX_ATTEMPTS=5
GEN_AUTOMATION_BACKGROUND_SEMANTIC_RETRY_BASE_SECONDS=30
GEN_AUTOMATION_BACKGROUND_SEMANTIC_RETRY_MAX_SECONDS=120

GEN_AUTOMATION_STORAGE_ENABLED=true
GEN_AUTOMATION_STORAGE_REGION=eu-central-1
GEN_AUTOMATION_STORAGE_BUCKET=
# Keep explicit storage access-key, secret-key, and session-token variables unset.

GEN_AUTOMATION_SALAD_ENABLED=false
GEN_AUTOMATION_GPU_ALLOCATION_ENABLED=false
GEN_AUTOMATION_SALAD_API_KEY=
GEN_AUTOMATION_SALAD_ORGANIZATION=
GEN_AUTOMATION_SALAD_PROJECT=
GEN_AUTOMATION_SALAD_QUEUE_NAME=comfyui-jobs-v1
GEN_AUTOMATION_SALAD_CONTAINER_GROUP_NAME=comfyui-worker-v1
GEN_AUTOMATION_SALAD_CONTAINER_PRIORITY=high
GEN_AUTOMATION_SALAD_MAX_QUEUED_JOBS=3
GEN_AUTOMATION_SALAD_MAX_HOURLY_COST_USD=0.35
GEN_AUTOMATION_SALAD_DAILY_BUDGET_USD=5.00
GEN_AUTOMATION_SALAD_MONTHLY_BUDGET_USD=25.00
GEN_AUTOMATION_SALAD_WEBHOOK_SECRET=
GEN_AUTOMATION_SALAD_WORKER_IMAGE=
GEN_AUTOMATION_WORKER_SIGNING_KEY_ID=worker-key-1
GEN_AUTOMATION_WORKER_SIGNING_PRIVATE_KEY=
GEN_AUTOMATION_SALAD_ATTEMPT_WATCHDOG_SECONDS=6300
GEN_AUTOMATION_SALAD_WORKER_ALLOWED_UPLOAD_ORIGIN=
GEN_AUTOMATION_SALAD_WORKER_MODEL_MANIFEST_JSON=
GEN_AUTOMATION_SALAD_WORKER_MODEL_MANIFEST_SHA256=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_BUCKET=
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_REGION=eu-central-1
# Nonsecret output `salad_worker_artifact_role_arn`; leave endpoint/static keys unset.
GEN_AUTOMATION_SALAD_WORKER_ARTIFACT_ROLE_ARN=

GEN_AUTOMATION_PUBLISHING_ENABLED=false
GEN_AUTOMATION_BACKGROUND_PUBLICATION_MAX_PACKAGE_BYTES=167772160
GEN_AUTOMATION_PATREON_BROWSER_PUBLISHING_ENABLED=false
GEN_AUTOMATION_PATREON_BROWSER_SIDECAR_URL=http://127.0.0.1:8090/v1/publish
GEN_AUTOMATION_PATREON_BROWSER_PROFILE_REFERENCE=creator-main
GEN_AUTOMATION_PATREON_BROWSER_SHARED_SECRET=

GEN_AUTOMATION_MEGA_DELIVERY_ENABLED=false
GEN_AUTOMATION_MEGA_PROFILE_HOME=/run/gen-automation/mega-profile
GEN_AUTOMATION_MEGA_REMOTE_ROOT=/Future
GEN_AUTOMATION_BACKGROUND_MEGA_BATCH_SIZE=100
GEN_AUTOMATION_BACKGROUND_MEGA_MAX_PACKAGE_BYTES=167772160

GEN_AUTOMATION_X_CREATOR_USER_ID=
GEN_AUTOMATION_X_OAUTH_SECRET_REFERENCE=
GEN_AUTOMATION_X_AUTH_MODE=oauth2
