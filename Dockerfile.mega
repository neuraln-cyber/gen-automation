# syntax=docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM python:3.14.7-slim@sha256:caaf356f40667c496d405780745b9ac25771c189a51dfcc42430d531ea09f8a2

LABEL org.opencontainers.image.title="gen-automation-control-plane-mega" \
      org.opencontainers.image.description="Control plane with official MEGAcmd completed-set delivery" \
      org.opencontainers.image.source="https://github.com/neuraln-cyber/gen-automation"

ENV HOME=/home/app \
    PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

# Apply only the Debian 13 security revisions required by the image gate.
# Keep the pinned Python runtime and all application dependencies unchanged.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends --no-remove --only-upgrade \
        libc6=2.41-12+deb13u4 \
        libc-bin=2.41-12+deb13u4 \
        perl-base=5.40.1-6+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.lock ./

# Pin an official MEGA Linux repository URL and its independently recorded
# SHA-256. The credential-bearing profile is mounted only at runtime.
ARG MEGACMD_DEB_URL=https://mega.nz/linux/repo/Debian_13/amd64/megacmd_2.6.0-2.1_amd64.deb
ARG MEGACMD_DEB_SHA256=9fb8c9a31a1c40b57fb54b2e8877988d957a8fcd09b78b3131cff28f0276fd0e
RUN test -n "${MEGACMD_DEB_URL}" \
    && test -n "${MEGACMD_DEB_SHA256}" \
    && case "${MEGACMD_DEB_URL}" in \
        https://mega.nz/linux/repo/*|https://mega.io/linux/repo/*) ;; \
        *) echo "MEGACMD_DEB_URL must use an official MEGA Linux repository" >&2; exit 1 ;; \
       esac \
    && echo "${MEGACMD_DEB_SHA256}" | grep -Eq '^[0-9a-fA-F]{64}$' \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && curl \
        --fail \
        --location \
        --proto '=https' \
        --tlsv1.2 \
        --output /tmp/megacmd.deb \
        "${MEGACMD_DEB_URL}" \
    && echo "${MEGACMD_DEB_SHA256}  /tmp/megacmd.deb" | sha256sum -c - \
    && test "$(dpkg-deb --field /tmp/megacmd.deb Package)" = "megacmd" \
    && test "$(dpkg-deb --field /tmp/megacmd.deb Version)" = "2.6.0-2.1" \
    && test "$(dpkg-deb --field /tmp/megacmd.deb Architecture)" = "amd64" \
    && apt-get install --yes --no-install-recommends /tmp/megacmd.deb \
    && rm -f /etc/apt/sources.list.d/megaio.sources \
    && rm -f /etc/apt/keyrings/meganz-archive-keyring.gpg \
    && command -v mega-ls \
    && command -v mega-mkdir \
    && command -v mega-find \
    && command -v mega-put \
    && command -v mega-get \
    && command -v mega-cmd \
    && command -v mega-whoami \
    && command -v mega-https \
    && rm -f /tmp/megacmd.deb \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m pip install \
        --only-binary=:all: \
        --require-hashes \
        --no-deps \
        -r requirements.lock \
    && python3.12 -m pip check \
    && python3.12 -c "import sys; assert sys.version_info[:2] == (3, 12)" \
    && groupadd --system --gid 10001 app \
    && useradd \
        --system \
        --create-home \
        --uid 10001 \
        --gid app \
        --home-dir /home/app \
        --shell /usr/sbin/nologin \
        app

COPY alembic.ini ./
COPY migrations ./migrations
COPY scripts/runpod_i2v_seed_volume.py ./scripts/runpod_i2v_seed_volume.py
COPY src ./src

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python3.12", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/live', timeout=2).read()"]

CMD ["python3.12", "-m", "uvicorn", "gen_automation.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log", "--no-server-header", "--no-date-header"]
